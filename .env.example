# ---------------------------------------------------------------------------
# MGM Host:Player — Data 360 live-ingestion config (server-side only).
# Copy to `.env` for local dev, or set these as Heroku config vars in prod.
# Leave unset to run in simulated mode (the demo works either way).
# ---------------------------------------------------------------------------

# Salesforce connected app with the CLIENT CREDENTIALS flow enabled. The
# run-as user needs Data Cloud ingest permission.
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Core login host. Use your My Domain URL for a specific org, e.g.
# https://mgm.my.salesforce.com  (defaults to login.salesforce.com).
SF_LOGIN_URL=https://login.salesforce.com

# Ingestion API source object developerName (matches the uploaded schema and
# the sourceApiName the app posts to). Optional — this is the default.
D360_SOURCE=mgmFloorEvents

# Local dev only: the Node server (node server.js) listens here; `vite dev`
# proxies /api -> this port. Heroku sets PORT automatically.
PORT=8080
