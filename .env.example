# ---------------------------------------------------------------------------
# MGM Host:Player — Data 360 live-ingestion config (server-side only).
# Copy to `.env` for local dev, or set these as Heroku config vars in prod.
# Leave unset to run in simulated mode (the demo works either way).
# ---------------------------------------------------------------------------

# Salesforce connected app using the JWT BEARER flow. The certificate
# (certificate.crt) is uploaded to the app; the matching private key is signed
# here. The run-as user (SF_USERNAME) needs Data Cloud ingest permission.
SF_CLIENT_ID=          # connected app Consumer Key → JWT iss
SF_USERNAME=           # run-as username → JWT sub, e.g. mgm@crm.demo
# PEM private key matching the uploaded cert. On Heroku set as one line with
# literal \n between lines; locally a real multi-line value is fine.
SF_PRIVATE_KEY=

# Core login host = JWT audience. Use your My Domain URL for a specific org,
# e.g. https://mgm.my.salesforce.com  (defaults to login.salesforce.com).
SF_LOGIN_URL=https://login.salesforce.com

# S2S Events API appSourceId — the system-generated Source ID from the Web &
# Mobile SDK "Server to Server" connection in Setup. The app POSTs events to
# /server/events/{appSourceId}. Optional — a default is baked into server.js.
D360_APP_SOURCE_ID=68544218-5272-4730-84aa-cfa6c3c2aa14

# Local dev only: the Node server (node server.js) listens here; `vite dev`
# proxies /api -> this port. Heroku sets PORT automatically.
PORT=8080
